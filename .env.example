# Copiez ce fichier en .env.local et renseignez vos valeurs Supabase
# (Project Settings > API dans le dashboard Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# URL publique du site — sert au sitemap, à robots.txt et au metadataBase
# Open Graph. Optionnel en local (défaut : https://heneris.com, sans incidence
# sur le dev). En production Vercel : NEXT_PUBLIC_SITE_URL=https://heneris.com
NEXT_PUBLIC_SITE_URL=
